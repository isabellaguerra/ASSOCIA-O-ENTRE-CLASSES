public class Cliente {

    String nome;
    String email;

    // Construtor
    public Cliente(String nome, String email) {
        this.nome = nome;
        this.email = email;
    }

    // Método para exibir dados
    public void exibirCliente() {
        System.out.println("Nome: " + nome);
        System.out.println("Email: " + email);
    }
}
